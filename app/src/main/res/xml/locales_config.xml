<?xml version="1.0" encoding="utf-8"?>
<!--
  Locales config: declared so Android 13+ uses per-app language preferences
  and the system correctly handles RTL/LTR switching at runtime.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
</locale-config>
