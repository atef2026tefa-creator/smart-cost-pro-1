# ─────────────────────────── Server ───────────────────────────
# Stage 3.3.2: changed from 3000 to 3001 (3000 is taken by smart-time-ai on the same server).
PORT=3001
NODE_ENV=production

# ─────────────────────────── Database ───────────────────────────
# PostgreSQL connection. On Oracle Cloud VM we run Postgres in a Docker container
# bound to 127.0.0.1:5432 only — see SETUP_ORACLE_BACKEND.md for the docker command.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smartcost
DB_USER=smartcost_user
DB_PASSWORD=REPLACE_ME_WITH_A_STRONG_DB_PASSWORD

# ─────────────────────────── JWT ───────────────────────────
# REQUIRED: the server refuses to start without this. Generate with:
#   openssl rand -hex 64
JWT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_hex_64_AT_LEAST_64_CHARS_LONG
JWT_EXPIRES_IN=30d

# ─────────────────────────── SMTP (Gmail) ───────────────────────────
# Create an App Password at https://myaccount.google.com/apppasswords
# (your regular Gmail password won't work because of 2FA).
# Use a NEW App Password dedicated to Smart Cost Pro — do NOT reuse smart-time-ai's.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME_WITH_YOUR_GMAIL@gmail.com
SMTP_PASS=REPLACE_ME_WITH_16_CHAR_APP_PASSWORD
SMTP_FROM="Smart Cost Pro <REPLACE_ME_WITH_YOUR_GMAIL@gmail.com>"

# ─────────────────────────── OTP ───────────────────────────
OTP_VALIDITY_MINUTES=10
OTP_RATE_LIMIT_PER_HOUR=5

# ─────────────────────────── CORS ───────────────────────────
# Comma-separated list of allowed origins (the Android app's package name is
# not an origin — leave empty to allow any origin in dev, or set to your domain).
CORS_ORIGINS=https://smart-cost-pro.duckdns.org

# ─────────────────────────── Google Sign-In (optional) ───────────────────────────
# The Web Client ID from Google Cloud Console → APIs & Services → Credentials.
# This MUST match the `serverClientId` in LoginScreen.kt and the `oauth_client` of type 3
# in google-services.json. Leave empty to disable Google Sign-In.
GOOGLE_CLIENT_ID=REPLACE_ME_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
